# Copy to .env.docker and fill the values. NEVER commit .env.docker.
# docker compose --env-file .env.docker up -d --build

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=devtasks
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=devtasks
# Host port for psql/IDE access (inside Compose the app uses postgres:5432)
POSTGRES_PORT=5433

# ── App ───────────────────────────────────────────────────────────────
APP_PORT=5001
CORS_ORIGIN=http://localhost:5001
# Set to 1 when running behind Cloudflare Tunnel / nginx
TRUST_PROXY=0

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Recommended: separate secrets so rotating JWT doesn't break uploads/keys
UPLOADS_SECRET=
API_KEY_ENCRYPTION_SECRET=

# Google OAuth. The browser origin must be http://localhost:5001
# (or https://app.tudominio) in Google Cloud Console.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional: AI providers. Users can also save their own keys in Settings.
AI_DEEPSEEK_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_GEMINI_API_KEY=
AI_ALLOWED_BASE_URLS=
AI_IMPORT_MAX_TOKENS=7168
