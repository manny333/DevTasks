# Copy to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL (docker compose maps 5433 -> 5432)
DATABASE_URL="postgresql://devtasks:devtasks123@localhost:5433/devtasks?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
GOOGLE_CLIENT_ID=""

# Server
PORT=5001
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# Absolute path of the built frontend (defaults to ../../frontend/dist)
STATIC_DIR=""
# Set to 1 behind Cloudflare/nginx so req.ip uses X-Forwarded-For
TRUST_PROXY=""

# Uploads: every /uploads URL is HMAC-signed. Falls back to JWT_SECRET if unset.
UPLOADS_SECRET=""

# AI providers (optional; users can also save their own keys in Settings)
AI_DEEPSEEK_API_KEY=""
AI_OPENAI_API_KEY=""
AI_ANTHROPIC_API_KEY=""
AI_GEMINI_API_KEY=""
# Override models if a provider retires the default one
# AI_DEEPSEEK_MODEL="deepseek-chat"
# AI_OPENAI_MODEL="gpt-4o"
# AI_ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
# AI_GEMINI_MODEL="gemini-2.0-flash"
# Comma-separated prefixes allowed as a custom baseUrl (self-hosted gateways).
# When empty only the official provider hosts over https are accepted.
AI_ALLOWED_BASE_URLS=""
